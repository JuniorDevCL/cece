# Copia este archivo como .env.local para desarrollo local

# Neon conectado en Vercel — usa la variable que Vercel crea automáticamente
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Alternativa legacy (opcional, solo si no usas DATABASE_URL)
# POSTGRES_URL="..."

# Auth.js — genera uno con: openssl rand -base64 32
AUTH_SECRET="reemplaza-con-un-secreto-largo"

# URL pública de la app
# Local:
AUTH_URL="http://localhost:3000"
# Producción Vercel:
# AUTH_URL="https://tu-app.vercel.app"
