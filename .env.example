# Copia este archivo como .env.local para desarrollo local

# Vercel Postgres (Neon) — Storage → Postgres en el dashboard de Vercel
POSTGRES_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js — genera uno con: openssl rand -base64 32
AUTH_SECRET="reemplaza-con-un-secreto-largo"

# URL pública de la app (local o producción)
AUTH_URL="http://localhost:3000"

# En Vercel producción también define:
# AUTH_URL="https://tu-app.vercel.app"
